{
  "id": "/workspace",
  "name": "Mico Workspace",
  "short_name": "Workspace",
  "description": "Your personal and business workspace.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#2f5bff",
  "icons": [
    { "src": "/workspace-icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/workspace-icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/workspace-icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Personal workspace", "short_name": "Personal", "url": "/dashboard", "icons": [{ "src": "/workspace-icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Business workspace", "short_name": "Business", "url": "/business/clients", "icons": [{ "src": "/workspace-icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
